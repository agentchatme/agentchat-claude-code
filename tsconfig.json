{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "strict": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "outDir": "dist", "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"]
}
